# --------------------------------------------------------------------------- helpers
def read(path):
    with open(path, "r", encoding="utf-8", errors="replace") as fh:
        return fh.read()


def strip_html_comments(s):
    return re.sub(r"<!--.*?-->", "", s, flags=re.S)


def strip_c_comments(s):
    return re.sub(r"/\*.*?\*/", "", s, flags=re.S)


def strip_js_comments(s):
    s = strip_c_comments(s)
    return re.sub(r"(?m)(?<![:\"'\\])//.*$", "", s)


def css_rules(css):
    """Very small CSS parser -> list of (selectors, declarations)."""
    css = strip_c_comments(css)
    rules = []
    for m in re.finditer(r"([^{}]+)\{([^{}]*)\}", css):
        sels = [x.strip().lower() for x in m.group(1).split(",") if x.strip()]
        decls = {}
        for d in m.group(2).split(";"):
            if ":" in d:
                k, v = d.split(":", 1)
                v = re.sub(r"\s*!important", "", v.strip().lower())
                decls[k.strip().lower()] = v
        rules.append((sels, decls))
    return rules


def merged_style(rules, wanted):
    """Declarations that apply to the given selectors (the last one wins, like in CSS)."""
    out = {}
    for sels, decls in rules:
        if any(s in wanted for s in sels):
            out.update(decls)
    return out


def tag_selectors(tag_attrs, tag_name):
    wanted = {tag_name}
    m = re.search(r"\bid\s*=\s*[\"']?([\w-]+)", tag_attrs, re.I)
    if m:
        wanted.add("#" + m.group(1).lower())
        wanted.add(tag_name + "#" + m.group(1).lower())
    m = re.search(r"\bclass\s*=\s*[\"']([^\"']+)[\"']", tag_attrs, re.I)
    if m:
        for c in m.group(1).split():
            wanted.add("." + c.lower())
            wanted.add(tag_name + "." + c.lower())
    return wanted


def inline_style(tag_attrs):
    m = re.search(r"\bstyle\s*=\s*\"([^\"]*)\"|\bstyle\s*=\s*'([^']*)'", tag_attrs, re.I)
    decls = {}
    if m:
        for d in (m.group(1) or m.group(2)).split(";"):
            if ":" in d:
                k, v = d.split(":", 1)
                decls[k.strip().lower()] = v.strip().lower()
    return decls


def is_big(value, axis):
    """True if a width/height value makes the iframe cover (almost) the whole page."""
    v = value.strip().lower()
    m = re.match(r"^(\d+(?:\.\d+)?)\s*(%|vw|vh|px)?$", v)
    if not m:
        return "100" in v          # calc(100% - ...), 100dvh, ...
    num, unit = float(m.group(1)), m.group(2)
    if unit in ("%", "vw", "vh"):
        return num >= 95
    return num >= (800 if axis == "w" else 500)


def is_transparent(v):
    v = v.replace(" ", "")
    if v in ("transparent", "#0000", "#00000000", "rgba(0,0,0,0)"):
        return True
    return bool(re.match(r"^(rgba|hsla)\([^)]*,0(\.0+)?\)$", v))


def http_get(ip, host, timeout=6):
    req = urllib.request.Request("http://%s/" % ip, headers={"Host": host, "Cache-Control": "no-cache"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.status, dict((k.lower(), v) for k, v in resp.getheaders()), resp.read().decode("utf-8", "replace")


# --------------------------------------------------------------------------- checks
# every check returns a list of (ok, message)

