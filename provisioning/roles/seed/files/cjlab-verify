def load_attacker(lab):
    html = strip_html_comments(read(os.path.join(lab, "attacker", "attacker.html")))
    css = read(os.path.join(lab, "attacker", "attacker.css"))
    return html, css


def check_task1(lab):
    res = []
    html, css = load_attacker(lab)
    m = re.search(r"<iframe\b([^>]*)>", html, re.I | re.S)
    res.append((bool(m), "attacker.html contains an <iframe> element (not inside a comment)"))
    if not m:
        return res
    attrs = m.group(1)
    sm = re.search(r"\bsrc\s*=\s*(?:\"([^\"]*)\"|'([^']*)'|([^\s>]+))", attrs, re.I)
    src = (sm.group(1) or sm.group(2) or sm.group(3)) if sm else ""
    host = (urlparse(src).hostname or "").lower()
    res.append((host == DEFENDER_HOST, "the iframe src points to http://www.cjlab.com"))
    b = re.search(r"<button\b", html, re.I)
    res.append((bool(b) and b.start() > m.start(), "the malicious <button> comes AFTER the iframe in the HTML"))

    style = merged_style(css_rules(css), tag_selectors(attrs, "iframe"))
    style.update(inline_style(attrs))
    border_ok = (
        re.match(r"^(none|0)\b", style.get("border", "x")) is not None
        or style.get("border-width", "x").startswith("0")
        or style.get("border-style", "x") == "none"
        or re.search(r"\bframeborder\s*=\s*[\"']?0", attrs, re.I) is not None
    )
    res.append((border_ok, "the iframe has no border"))
    res.append(("width" in style and is_big(style["width"], "w"), "the iframe CSS gives it a full-page width"))
    res.append(("height" in style and is_big(style["height"], "h"), "the iframe CSS gives it a full-page height"))
    return res


def check_task2(lab):
    res = check_task1(lab)
    html, css = load_attacker(lab)
    b = re.search(r"<button\b([^>]*)>", html, re.I | re.S)
    res.append((bool(b) and "hacked.html" in b.group(1), "the malicious button still leads to hacked.html"))
    wanted = tag_selectors(b.group(1) if b else "", "button")
    style = merged_style(css_rules(css), wanted)
    if b:
        style.update(inline_style(b.group(1)))

    opacity = None
    try:
        opacity = float(style.get("opacity", "1"))
    except ValueError:
        pass
    invisible = (opacity is not None and opacity <= 0.05) or (
        is_transparent(style.get("background-color", "")) and is_transparent(style.get("color", "")))
    res.append((invisible, "the malicious button is invisible (opacity 0, or transparent color AND background-color)"))

    broken = (style.get("display") == "none" or style.get("visibility") in ("hidden", "collapse")
              or style.get("pointer-events") == "none"
              or re.match(r"^-\d", style.get("z-index", "0")) is not None)
    res.append((not broken, "...but still clickable (no display:none / visibility:hidden / pointer-events:none / negative z-index)"))

    moved = any(k in style and style[k].strip() not in ("0", "0px", "auto", "")
                for k in ("margin-left", "margin-top", "margin", "left", "top", "transform", "translate"))
    res.append((moved, "the button has been moved (margin-left / margin-top / left / top ...)"))
    return res


def extract_function_body(js, name):
    m = re.search(r"function\s+%s\s*\(\s*\)\s*\{" % re.escape(name), js)
    if not m:
        return None
    depth, i = 1, m.end()
    while i < len(js) and depth:
        depth += {"{": 1, "}": -1}.get(js[i], 0)
        i += 1
    return js[m.end():i - 1]


def check_task3(lab):
    res = []
    html = strip_html_comments(read(os.path.join(lab, "defender", "index.html")))
    js = "\n".join(strip_js_comments(s) for s in re.findall(r"<script\b[^>]*>(.*?)</script>", html, re.S | re.I))
    body = extract_function_body(js, "makeThisFrameOnTop")
    res.append((body is not None and body.strip() != "", "makeThisFrameOnTop() in defender/index.html is no longer empty"))
    body = body or ""
    res.append((re.search(r"\btop\b", body) is not None and re.search(r"\bself\b", body) is not None
                and re.search(r"!==|!=|===|==", body) is not None,
                "it compares window.top with window.self"))
    assigns = re.search(r"\btop\.location(\.href)?\s*=(?!=)|\btop\.location\.(replace|assign)\s*\(", body) is not None
    res.append((assigns and body.count("location") >= 2,
                "it sets the location of the top window to the location of the current window"))
    res.append((len(re.findall(r"makeThisFrameOnTop\s*\(", js)) >= 2, "the function is still called from window.onload"))
    return res


def check_task4(lab):
    res = []
    html, _ = load_attacker(lab)
    m = re.search(r"<iframe\b([^>]*)>", html, re.I | re.S)
    attrs = m.group(1) if m else ""
    sb = re.search(r"\bsandbox\b(?:\s*=\s*(?:\"([^\"]*)\"|'([^']*)'|([^\s>]*)))?", attrs, re.I)
    res.append((sb is not None, "the iframe in attacker.html has the sandbox attribute"))
    tokens = ((sb.group(1) or sb.group(2) or sb.group(3) or "") if sb else "").lower().split()
    res.append(("allow-top-navigation" not in tokens, "...without the token allow-top-navigation"))
    res.append(("allow-scripts" not in tokens, "...without allow-scripts (the frame-buster must not be able to run)"))
    res.append((True, "--- prerequisites that must still be in place ---"))
    res += check_task2(lab)
    res += check_task3(lab)
    return res


def check_task5(lab):
    res = []
    try:
        code, headers, _ = http_get(DEFENDER_IP, DEFENDER_HOST)
    except Exception as exc:  # noqa
        return [(False, "http://www.cjlab.com is not reachable (%s) - are the containers running?" % exc)]
    xfo = headers.get("x-frame-options", "").strip().upper()
    csp = headers.get("content-security-policy", "")
    res.append((xfo == "DENY", "the server answers with the header X-Frame-Options: DENY (found: %r)" % xfo))
    res.append((re.search(r"frame-ancestors\s+'none'", csp, re.I) is not None,
                "the server answers with Content-Security-Policy: frame-ancestors 'none' (found: %r)" % csp))
    return res


CHECKS = {0: check_task0, 1: check_task1, 2: check_task2, 3: check_task3, 4: check_task4, 5: check_task5}


# --------------------------------------------------------------------------- main
def main(argv):
    if len(argv) != 2 or argv[1] == "list" or not argv[1].isdigit() or int(argv[1]) not in CHECKS:
        print(__doc__)
        for n in sorted(TITLES):
            print("  %d  %s" % (n, TITLES[n]))
        return 0 if len(argv) == 2 and argv[1] == "list" else 2
    task = int(argv[1])
    if os.geteuid() != 0:
        print("Please run:  sudo cjlab-verify %d" % task)
        return 2
    try:
        cfg = json.loads(read(SECRETS))
        lab = cfg["labsetup"]
        flag = cfg["flags"][str(task)]
    except Exception as exc:  # noqa
        print("Internal error: cannot read the flag store (%s). Tell your instructor." % exc)
        return 3

    print("\n== %s ==\n" % TITLES[task])
    try:
        results = CHECKS[task](lab)
    except FileNotFoundError as exc:
        print("[FAIL] file not found: %s" % exc.filename)
        return 1
    all_ok = True
    for ok, msg in results:
        if msg.startswith("---"):
            print("  " + msg)
            continue
        print("  [%s] %s" % (" OK " if ok else "FAIL", msg))
        all_ok = all_ok and ok
    print()
    if not all_ok:
        print("Not validated yet - fix the FAIL lines above and run the tool again.")
        return 1
    bar = "=" * (len(flag) + 14)
    print(bar)
    print("  TASK %d VALIDATED" % task)
    print("  Your flag:  %s" % flag)
    print(bar)
    print("Copy it EXACTLY into the answer box of CyberRangeCZ. It is valid for your sandbox only.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
